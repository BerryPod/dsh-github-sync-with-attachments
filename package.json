{
  "name": "dsh-github-sync-with-attachments",
  "version": "0.5.0",
  "description": "dsh 插件 · 在 dsh-github-sync 0.4.3 基础上增加 attachments 目录备份：会话 sessions、图片/文件附件 attachments、插件清单、设置，用 GitHub 私有仓库多机同步。纯 REST（不需要 git 二进制），token 只写不回读，各机路径互不覆盖。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "sync",
    "github",
    "session",
    "attachment",
    "dsh-plugin"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check client/index.js",
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {},
  "author": "BerryPod (https://github.com/BerryPod)",
  "contributors": [
    {
      "name": "minghuo",
      "url": "https://github.com/minghuo"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BerryPod/dsh-github-sync-with-attachments.git"
  },
  "homepage": "https://github.com/BerryPod/dsh-github-sync-with-attachments#readme",
  "bugs": {
    "url": "https://github.com/BerryPod/dsh-github-sync-with-attachments/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
